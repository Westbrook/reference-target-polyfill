{
  "compilerOptions": {
    "experimentalDecorators": true,
    "inlineSources": true,
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "../../dist/angular",
    "rootDir": ".",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "types": [],
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "compilationMode": "full",
    "strictInjectionParameters": true,
    "strictTemplates": true
  },
  "files": ["components.ts"]
}
