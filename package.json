{
  "name": "reference-target-fallback",
  "version": "0.1.0",
  "private": true,
  "description": "A modular, component-aware fallback for selected Reference Target behaviors.",
  "author": "Westbrook Johnson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Westbrook/reference-target-polyfill.git"
  },
  "homepage": "https://westbrook.github.io/reference-target-polyfill/",
  "bugs": {
    "url": "https://github.com/Westbrook/reference-target-polyfill/issues"
  },
  "keywords": [
    "reference-target",
    "shadow-dom",
    "web-components",
    "polyfill",
    "accessibility"
  ],
  "type": "module",
  "sideEffects": [
    "./examples/reference-target.setup.js",
    "./examples/*/reference-target.setup.js",
    "./examples/app.js",
    "./examples/*/app.js",
    "./examples/shared/features/*.js"
  ],
  "exports": {
    "./core": {
      "types": "./types/core.d.ts",
      "default": "./src/core.js"
    },
    "./detect": {
      "types": "./types/detect.d.ts",
      "default": "./src/detect.js"
    },
    "./detect/surface": {
      "types": "./types/detect/surface.d.ts",
      "default": "./src/detect/surface.js"
    },
    "./adapters/labels": {
      "types": "./types/adapters/labels.d.ts",
      "default": "./src/adapters/labels.js"
    },
    "./adapters/popover-targets": {
      "types": "./types/adapters/popover-targets.d.ts",
      "default": "./src/adapters/popover-targets.js"
    },
    "./adapters/dialog-commands": {
      "types": "./types/adapters/dialog-commands.d.ts",
      "default": "./src/adapters/dialog-commands.js"
    },
    "./adapters/popover-commands": {
      "types": "./types/adapters/popover-commands.d.ts",
      "default": "./src/adapters/popover-commands.js"
    },
    "./adapters/text-names": {
      "types": "./types/adapters/text-names.d.ts",
      "default": "./src/adapters/text-names.js"
    },
    "./adapters/form-targets": {
      "types": "./types/adapters/form-targets.d.ts",
      "default": "./src/adapters/form-targets.js"
    },
    "./dom": {
      "types": "./types/dom.d.ts"
    }
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prestart": "npm run build:pages",
    "start": "node scripts/serve.js",
    "serve": "node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "npm run build:pages && node scripts/browser-test.js --browser chromium",
    "test:browser:firefox": "npm run build:pages && node scripts/browser-test.js --browser firefox",
    "build:browser": "node scripts/build-browser.js",
    "build:example": "node scripts/build-example.js",
    "build:pages": "node scripts/build-pages.js",
    "prepare:pages": "npm run build:pages && node scripts/prepare-pages.js",
    "check": "npm test && npm run build:pages && npm pack --dry-run --ignore-scripts --cache .npm"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.3 || ^24.15.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/compiler-cli": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/elements": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@babel/core": "8.0.1",
    "@microsoft/fast-element": "3.0.2",
    "@stencil/core": "4.44.2",
    "esbuild": "^0.28.2",
    "lit": "3.3.3",
    "microlighter": "2.1.0",
    "preact": "10.29.8",
    "rxjs": "7.8.2",
    "svelte": "5.57.0",
    "typescript": "6.0.3",
    "vue": "3.5.42"
  }
}
